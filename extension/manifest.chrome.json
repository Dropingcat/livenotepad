{
  "manifest_version": 3,
  "name": "Живой блокнот",
  "version": "0.1",
  "description": "Боковая панель для заметок на день: живой лист, сроки, ветки, корзина.",
  "author": "Dropingcat",
  "homepage_url": "https://dropingcat.github.io/livenotepad/",
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "side_panel": {
    "default_path": "sidebar.html"
  },
  "background": {
    "service_worker": "background-sw.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "sidePanel"
  ],
  "minimum_chrome_version": "114"
}